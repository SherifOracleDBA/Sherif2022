#!/bin/bash
set -euo pipefail

dnf install -y python3 python3-pip
install -d -m 0755 /opt/portfolio

printf '%s' "${app_code_base64}" | base64 --decode > /opt/portfolio/app.py
printf '%s' "${requirements_base64}" | base64 --decode > /opt/portfolio/requirements.txt
chmod 0644 /opt/portfolio/app.py /opt/portfolio/requirements.txt

python3 -m venv /opt/portfolio/venv
/opt/portfolio/venv/bin/pip install --no-cache-dir -r /opt/portfolio/requirements.txt

cat > /etc/systemd/system/portfolio-web.service <<'SERVICE'
[Unit]
Description=AWS portfolio demonstration web application
After=network.target

[Service]
Type=simple
User=nobody
Group=nobody
WorkingDirectory=/opt/portfolio
Environment="DB_SECRET_ARN=${db_secret_arn}"
Environment="AWS_DEFAULT_REGION=${aws_region}"
Environment="APP_HOST=0.0.0.0"
Environment="APP_PORT=8080"
ExecStart=/opt/portfolio/venv/bin/python /opt/portfolio/app.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable --now portfolio-web.service
